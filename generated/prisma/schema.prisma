  layout String @default("grid") // grid | masonry | carousel | collage | justified

  // Grid settings
  columns      Int     @default(3) // 2, 3, 4, 5
  gap          Int     @default(16) // Gap between images in px
  aspectRatio  String? @default("1:1") // 1:1, 4:3, 16:9, auto
  captionStyle String? @default("overlay") // overlay | hover | below

  // Display settings
  showCaptions   Boolean @default(true)
  enableLightbox Boolean @default(true)

  // Multi-tenancy
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Relationships
  images GalleryImage[]
  // NOTE: no @@index([businessId]) — covered by the @@unique([businessId, slug]) prefix.

  @@unique([businessId, slug])
}

model GalleryImage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Image data
  url     String
  altText String?
  caption String?
  width   Int?
  height  Int?

  // Ordering
  sortOrder Int @default(0)

  // Relationships
  galleryId String
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId, sortOrder])
}

model Testimonial {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Who created this
  source String @default("customer") // "customer" | "owner"

  // Content — name, text, photos only (no rating/video)
  title     String? // Optional title (owner-created often has one)
  text      String   @db.Text
  photoUrls String[] // Max 5; enforced in API

  // Status — two-boolean moderation model (mirrors ProductReview)
  isApproved Boolean @default(false) // owner has approved for display
  isHidden   Boolean @default(false) // owner has hidden after approval
  // Visibility: isApproved && !isHidden
  // Status: PENDING = !isApproved && !isHidden; PUBLISHED = isApproved && !isHidden; HIDDEN = isHidden

  // Attribution (used by both types)
  customerName    String
  customerEmail   String? // Optional for owner-created (may not have email)
  customerTitle   String? // e.g. "CEO at Acme" — for owner-created context
  customerCompany String? // e.g. "Acme Corp" — for owner-created context

  // Dates — owner can backdate testimonials from another system
  testimonialDate DateTime @default(now())

  // Relationships
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId, isApproved, isHidden])
  @@index([businessId, source])
  @@index([customerId])
}

model TestimonialInvite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime

  // Invite details
  email     String
  code      String    @unique // Unique code for URL
  used      Boolean   @default(false)
  usedAt    DateTime?
  maxPhotos Int       @default(3) // 0–5 photos allowed for this invite

  // Relationships
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerId String? // If inviting existing customer
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId])
  // NOTE: no @@index([code]) — already @unique (own index).
  @@index([email])
  @@index([customerId])
}

model ProductReview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Origin
  source String @default("customer") // "customer" | "owner"

  // Content
  rating   Int
  title    String? // Optional — owner-created often has one; customer required
  comment  String   @db.Text
  images   String[]
  videoUrl String?

  // Verification (customer only)
  verifiedPurchase Boolean @default(false)

  // Moderation
  // customer-submitted: starts false, owner approves
  // owner-created: starts true by default
  isApproved Boolean @default(false)
  isHidden   Boolean @default(false)

  // Attribution
  customerName  String
  customerEmail String? // Optional for owner-created
  customerTitle String? // e.g. "Verified Buyer" or "Professional Chef"

  // Dates — owner can backdate
  reviewDate DateTime @default(now())

  // Helpful votes (customer reviews only)
  helpfulCount    Int @default(0)
  notHelpfulCount Int @default(0)

  // Relationships
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  votes ReviewVote[]

  @@index([productId, isApproved, isHidden])
  @@index([productId, source])
  @@index([customerId])
  @@index([orderId])
}

model ReviewVote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  isHelpful Boolean // true = helpful, false = not helpful

  // Relationships
  reviewId String
  review   ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  // Voter identification (either authenticated or by IP)
  userId    String?
  ipAddress String?

  // NOTE: Uniqueness is enforced by hand-written PARTIAL unique indexes
  // (`... WHERE "userId" IS NOT NULL` / `... WHERE "ipAddress" IS NOT NULL`) so that
  // NULL voter identifiers are not treated as distinct (which would let duplicate
  // votes slip past a plain multi-column UNIQUE index). Prisma cannot express partial
  // indexes in-schema, and declaring plain `@@unique`s here made every
  // `db push`/`migrate dev` diff try to re-create them (42P07 collisions with the
  // partial indexes' names). No code uses the compound unique client keys, so the
  // `@@unique` declarations were removed. See migration p2_schema_integrity.
  @@index([reviewId])
}

// Platform admin invite codes for business creation wizard
model PlatformInvite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime

  // Who is this for?
  email String
  code  String @unique // Used in wizard URL

  // What role will they have?
  role BusinessRole // "owner" | "admin"

  // If owner, which business? (can be pre-created or created during wizard)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  // Status
  used   Boolean   @default(false)
  usedAt DateTime?
  usedBy String? // userId who redeemed it

  // Who created this invite
  createdBy String?
  creator   User?   @relation("CreatedInvites", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([email])
  // NOTE: no @@index([code]) — already @unique (own index).
  @@index([businessId])
  @@index([createdBy])
}

model TeamInvite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime

  email  String
  code   String       @unique
  role   BusinessRole
  used   Boolean      @default(false)
  usedAt DateTime?

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdBy String?

  @@index([businessId])
  // NOTE: no @@index([code]) — already @unique (own index).
  @@index([email])
}

// ============================================
// PLATFORM CONFIGURATION
// ============================================

model PlatformConfig {
  id                 String   @id @default("singleton")
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?
  updatedAt          DateTime @updatedAt
}

// ============================================
// ZONE + WEIGHT SHIPPING
// ============================================

model ShippingZone {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name      String // e.g. "Zone 1 – Origin Region"
  states    String[] // US 2-letter state codes in this zone
  sortOrder Int      @default(0)

  rates ShippingRate[]
  // NOTE: no @@index([businessId]) — covered by the @@unique([businessId, name]) prefix.

  @@unique([businessId, name])
}

model ShippingRate {
  id String @id @default(cuid())

  zoneId String
  zone   ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  tierIndex  Int // position in Business.shippingWeightTiers (0-based)
  priceCents Int // shipping price in cents for this zone + tier combination
  // NOTE: no @@index([zoneId]) — covered by the @@unique([zoneId, tierIndex]) prefix.

  @@unique([zoneId, tierIndex])
}

// A shopper's request to be emailed when an out-of-stock product is restocked.
// Fulfilled by the /api/cron restock job; duplicates are prevented in code
// (nullable variantId keeps a DB unique constraint from applying cleanly).
model BackInStockRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  email     String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?

  notifiedAt DateTime?

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Prevent duplicate PENDING signups for the same email + product + variant
  // within a business. NOTE: Uniqueness is enforced by a hand-written PARTIAL
  // unique index (`... WHERE "notifiedAt" IS NULL`) — notified rows are kept as
  // history by the cron, and a plain UNIQUE would block a legitimate
  // re-subscribe after a notification (silently, via subscribe's P2002 catch).
  // Prisma cannot express partial indexes in-schema, and declaring a plain
  // `@@unique` here made every `db push`/`migrate dev` diff try to re-create it
  // (42P07 collision with the partial index's name). No code uses the compound
  // unique client key, so the `@@unique` declaration was removed (same pattern
  // as ReviewVote). See migration p4_backinstock_unique.
  // Also: Postgres treats NULLs as distinct, so variant-less signups
  // (variantId IS NULL) are still deduped in app code (subscribe's findFirst).
  @@index([businessId, productId])
  @@index([notifiedAt, productId])
  @@index([productId])
}

// ============================================
// QUOTE CALCULATOR
// ============================================

model QuoteCalculator {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name       String
  // Versioned definition blob: questions, options, show-if conditions, distance
  // variables, formula, and display settings. Shape + refinements:
  // `quoteCalculatorDefinitionSchema` in src/lib/validators/quote-calculator.ts
  definition Json
  published  Boolean @default(false)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  submissions QuoteSubmission[]

  @@index([businessId]) // admin list + tiptap picker
}

model QuoteSubmission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NEW | CONTACTED | WON | LOST — QUOTE_STATUS_VALUES_DB in
  // src/lib/validators/quote-calculator.ts
  status String @default("NEW")

  contactName  String /// @encrypted
  contactEmail String /// @encrypted
  contactPhone String? /// @encrypted

  // Self-contained answer snapshot: [{questionId, type, title, variableName?,
  // hidden, ...answer fields, display}] — `quoteSubmissionAnswerSchema`.
  // Labels are denormalized so the inbox renders after the calculator is
  // edited or deleted.
  answers                Json
  // Exact server-computed estimate in cents; always owner-visible. IMMUTABLE —
  // owner adjustments go on `finalQuoteCents` so the computed record survives.
  estimateCents          Int?
  // { formula, variables } captured at submit time — `quoteFormulaSnapshotSchema`.
  // Lets the owner audit how the number was produced.
  formulaSnapshot        Json
  // Owner-adjusted authoritative amount in cents (null = not adjusted yet).
  // This — not estimateCents — is what a future invoice/deposit bills against.
  finalQuoteCents        Int?
  // Last final-quote email sent to the customer: when, for how much, with what
  // message. Audit snapshot — finalQuoteCents may be edited again afterwards.
  quoteSentAt            DateTime?
  sentQuoteCents         Int?
  sentMessage            String? /// @encrypted
  // Calculator identity/settings snapshotted at submit time (survive deletion).
  calculatorName         String
  showEstimateToCustomer Boolean   @default(false)

  // SetNull, not Cascade: submissions are business records (a lead pipeline)
  // and must outlive the calculator that produced them; everything the inbox
  // renders is snapshotted onto this row.
  calculatorId String?
  calculator   QuoteCalculator? @relation(fields: [calculatorId], references: [id], onDelete: SetNull)

  // Invoices issued against this lead through QuickBooks (SetNull on the
  // invoice side: money records outlive the lead).
  quickBooksInvoices QuickBooksInvoice[]

  // Denormalized for join-free inbox listing (Testimonial precedent).
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status, createdAt]) // inbox: status filter + newest-first
  @@index([businessId, createdAt]) // inbox: unfiltered listing
  @@index([calculatorId]) // SetNull fan-out on calculator delete
}

/// One QuickBooks Online company connection per business (1:1). Updated in
/// place on reconnect and never deleted by the app, so deposit settings and
/// the cached QBO reference ids survive a disconnect/reconnect cycle.
/// Tokens are `/// @encrypted` (prisma-field-encryption) and are nulled on
/// disconnect. Encrypted columns can never appear in a `where`.
model QuickBooksConnection {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // active | needs_reconnect | disconnected — QBO_CONNECTION_STATUS_VALUES in
  // src/lib/validators/quickbooks.ts. needs_reconnect = Intuit rejected the
  // refresh token (rotated away, revoked, or past its ~100-day life).
  status String @default("active")

  realmId     String // QBO company id, from the OAuth callback query string
  environment String // sandbox | production — QBO_ENVIRONMENT at connect time
  companyName String?

  accessToken           String?   @db.Text /// @encrypted
  refreshToken          String?   @db.Text /// @encrypted
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  lastRefreshAt         DateTime?
  connectedAt           DateTime  @default(now())
  disconnectedAt        DateTime?

  // Deposit rule: percent of the quote OR a fixed amount. Prefills the
  // "Send deposit invoice" dialog; the owner can override per invoice.
  depositMode       String @default("percent") // percent | fixed
  depositPercent    Int    @default(25) // 1..100, whole percent
  depositFixedCents Int    @default(0)
  defaultDueDays    Int    @default(7)

  // Per-realm QBO reference cache. Reset whenever realmId changes on
  // reconnect — ids from one company are meaningless in another.
  incomeAccountId String?
  depositItemId   String?
  serviceItemId   String?
  depositItemName String  @default("Deposit")
  serviceItemName String  @default("Services")

  lastSyncAt    DateTime?
  lastSyncError String?   @db.Text

  @@index([status, lastSyncAt]) // cron: active connections, stalest first
}

/// One row per invoice SimplePress created in QuickBooks: audit trail, the
/// /admin/invoices list, and the cron sync target. Customer fields are a
/// snapshot taken at issue time (encrypted like QuoteSubmission's contact
/// fields). `realmId` is snapshotted per row so invoices from a previous
/// QBO company are recognizable after a reconnect.
model QuickBooksInvoice {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // SetNull, not Cascade: invoices are money records and must outlive the
  // lead they were issued against.
  quoteSubmissionId String?
  quoteSubmission   QuoteSubmission? @relation(fields: [quoteSubmissionId], references: [id], onDelete: SetNull)

  kind        String // deposit | final | custom — QBO_INVOICE_KIND_VALUES
  amountCents Int
  memo        String? @db.Text
  description String? // line-item description sent to QBO

  customerName  String /// @encrypted
  customerEmail String /// @encrypted
  customerPhone String? /// @encrypted

  // pending | created | sent | paid | overdue | voided | error —
  // QBO_INVOICE_STATUS_VALUES. `pending` = local row exists, QBO call in
  // flight; `error` = QBO create/send failed and can be retried.
  status       String    @default("pending")
  balanceCents Int?
  dueDate      DateTime?
  sentAt       DateTime?
  paidAt       DateTime?

  realmId       String
  qboCustomerId String?
  qboInvoiceId  String?
  qboDocNumber  String?
  qboSyncToken  String?

  lastSyncedAt DateTime?
  lastError    String?   @db.Text // truncated to 500 chars; owner-facing

  @@unique([realmId, qboInvoiceId]) // NULL qboInvoiceId rows never collide (Postgres)
  @@index([businessId, createdAt]) // /admin/invoices listing
  @@index([businessId, status, createdAt]) // list status filter
  @@index([quoteSubmissionId]) // lead card + SetNull fan-out
  @@index([status, lastSyncedAt]) // cron sweep: open invoices, stalest first
}

/// One customer's subscription to a recurring product purchase (Stripe Billing
/// on the store's connected account, parallel to the one-time checkout lane).
/// Created `incomplete` by the subscribe checkout-session route and promoted
/// by the webhook on `checkout.session.completed`. Product/pricing/cadence/
/// shipping-address are snapshotted at signup and LOCKED for the life of the
/// subscription — changing any of them is cancel + resubscribe, not an edit,
/// so renewals always bill exactly what's stored here regardless of later
/// product-price or address-book changes. Every paid invoice (first +
/// renewals) creates a normal `Order` keyed on `stripeInvoiceId`, so
/// fulfillment/inventory/refund/email code is entirely reused. Encrypted
/// columns (customer + shipping snapshot) can never appear in a `where` —
/// lookups use the plaintext `customerEmail` + `businessId`.
model Subscription {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // SetNull, not Cascade: a subscription (and the orders it produced) is a
  // money record and must outlive the Customer row if that's ever deleted.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Customer snapshot. customerEmail stays PLAINTEXT for lookup (manage-link
  // request + admin list), matching Order.customerEmail's precedent.
  customerEmail String
  customerName  String? /// @encrypted
  customerPhone String? /// @encrypted

  // Stripe. stripeCustomerId is the Stripe Customer on the connected account
  // (Customer.stripeCustomerId mirrors it once persisted). stripeSubscriptionId
  // and lastInvoiceId are unknown until the webhook fills them in.
  stripeSubscriptionId    String? @unique
  stripeCustomerId        String?
  stripeCheckoutSessionId String? @unique
  lastInvoiceId           String?

  // Product snapshot (SetNull: a subscription outlives a deleted product/variant).
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  productName      String
  variantName      String?
  sku              String?
  quantity         Int

  // Cadence + locked pricing (cents). Renewals bill exactly these numbers —
  // an existing subscriber keeps their locked price even if the product's
  // price or subscribe-and-save % changes later.
  intervalKey     String // week:1 | week:2 | month:1 | month:2 | month:3 — SUBSCRIPTION_INTERVAL_KEYS in src/lib/subscriptions/intervals.ts
  interval        String // week | month — Stripe recurring.interval
  intervalCount   Int // Stripe recurring.interval_count
  listPriceCents  Int
  discountPercent Int    @default(0)
  unitAmountCents Int
  shippingCents   Int    @default(0)
  deliveryMethod  String @default("ship") // ship | pickup

  // Locked shipping address (SetNull: the address-book entry may be edited or
  // deleted later without touching what a live subscription bills/ships to).
  // Encrypted snapshot fields stay null for deliveryMethod = "pickup".
  shippingAddressId String?
  shippingAddress   ShippingAddress? @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  shipFirstName     String? /// @encrypted
  shipLastName      String? /// @encrypted
  shipAddress1      String? /// @encrypted
  shipAddress2      String? /// @encrypted
  shipCity          String? /// @encrypted
  shipProvince      String? /// @encrypted
  shipZip           String? /// @encrypted
  shipCountry       String?

  // Lifecycle
  status              String    @default("incomplete") // incomplete | active | past_due | paused | cancelled
  pauseResumesAt      DateTime?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  nextBillingAt       DateTime?
  cancelledAt         DateTime?
  cancelReason        String? // customer | owner | stripe | payment_failed | checkout_expired
  lastPaymentFailedAt DateTime?
  lastSyncedAt        DateTime?

  // Acceptance of the MERCHANT's terms at signup — same rationale as Order's
  // identically-named fields.
  termsAcceptedAt        DateTime?
  termsVersion           String?
  merchantTermsUpdatedAt DateTime?

  orders Order[]

  @@index([businessId, status]) // admin list + cron scope
  @@index([businessId, customerEmail]) // manage-link lookup (requestManageLinks)
  @@index([customerId]) // SetNull fan-out + account page (getMine)
  @@index([status, lastSyncedAt]) // cron sweep: open subscriptions, stalest first
  @@index([productId]) // SetNull fan-out
}
