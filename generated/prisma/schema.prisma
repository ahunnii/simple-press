// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  PLATFORM_ADMIN // Was ADMIN - global, can do anything
  BUSINESS_USER // Was USER - customer/shopper, no admin access
}

enum BusinessRole {
  OWNER // Full control of one business
  MANAGER // Operational access, scoped per membership row
  STAFF // Fulfillment-only: orders and customer lookup, no products/settings/money
}

// Necessary for Better Auth

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique // ← globally unique now
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  platformRole  PlatformRole @default(BUSINESS_USER)

  // Acceptance of the PLATFORM's Terms of Service + Privacy Policy, recorded at
  // account creation. Scoped to SimplePress only, never to an individual store:
  // this account is portable across every storefront on the platform, so it
  // cannot meaningfully carry consent to any one merchant's terms. Merchant
  // terms are agreed per-transaction (see `Order`) and per-store for owners
  // (see `BusinessMembership`).
  //
  // Nullable because every account that existed before this shipped has no
  // recorded acceptance — do NOT backfill with a timestamp, which would assert
  // an agreement that never happened. `null` honestly means "unknown".
  // Version format is the ISO date from `~/lib/legal/policy-versions`.
  termsAcceptedAt DateTime?
  termsVersion    String?

  sessions Session[]
  accounts Account[]

  memberships      BusinessMembership[]
  customers        Customer[]
  inventoryHistory InventoryHistory[]
  createdInvites   PlatformInvite[]     @relation("CreatedInvites")
  editorNotes      EditorNote[]

  // ← removed businessId direct FK, membership table handles this
  @@map("user")
}

model BusinessMembership {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  role BusinessRole // ← typed enum, not a raw string

  // Acceptance of the Seller & Merchant Agreement + Acceptable Use Policy,
  // recorded when a store is created or an owner invite is claimed. These are
  // the documents that give the platform grounds to suspend a store, and on a
  // free platform they are the ONLY contract with the merchant — so this is
  // recorded per membership, not per user: one person can own two stores and
  // accepts separately for each.
  //
  // Nullable for memberships that predate this. `null` = never accepted, which
  // is exactly what it looks like; do not backfill.
  merchantTermsAcceptedAt DateTime?
  merchantTermsVersion    String?

  @@unique([userId, businessId])
  // NOTE: no @@index([userId]) — covered by the @@unique([userId, businessId]) prefix.
  @@index([businessId])
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String? //@db.Text
  userAgent            String? //@db.Text
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  // Business context — cached at session creation
  businessId     String?
  membershipId   String?
  membershipRole String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String //@db.Text
  providerId            String //@db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String? //@db.Text
  refreshToken          String? //@db.Text
  idToken               String? //@db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String? //@db.Text
  password              String? //@db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String //@db.Text
  value      String //@db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

enum BusinessDomainStatus {
  NONE
  PENDING_DNS
  ACTIVE
}

model Business {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Identity
  name            String
  slug            String               @unique // URL-friendly version of name
  subdomain       String               @unique // "anothershop" for anothershop.myapplication.com
  customDomain    String?              @unique // "anothershop.co"
  domainStatus    BusinessDomainStatus @default(NONE) // none | pending_dns | active
  afProvisionCode String?              @unique // Artisanal Futures provisioning idempotency key

  // Template & Branding
  templateId String @default("modern") // modern | vintage | minimal

  // IANA time zone used to format owner-facing and storefront dates/times (events
  // today). Stored instants are always UTC; this is display only. Defaults to the
  // platform's home zone rather than a UTC-ish placeholder so a store that never
  // touches the setting still reads correctly for its owner.
  timeZone String @default("America/Detroit")

  // Contact & Legal
  ownerEmail      String
  supportEmail    String?
  phoneNumber     String?
  businessAddress String?

  // Integrations
  stripeAccountId             String? @unique
  stripeAutoTaxEnabled        Boolean @default(false)
  stripeChargesEnabled        Boolean @default(false) // synced from account.updated webhook
  stripePayoutsEnabled        Boolean @default(false) // synced from account.updated webhook
  stripePortalConfigurationId String? // cached Stripe Customer Portal configuration on the connected account

  // Testimonials
  testimonialsAutoApprove Boolean @default(false) // when true, customer submissions are auto-approved

  // Storefront availability (owner-controlled, storefront only)
  maintenanceMode    Boolean @default(false)
  maintenanceVariant String  @default("maintenance") // "maintenance" | "coming_soon"
  maintenanceMessage String?

  // Analytics
  umamiWebsiteId String? // Each business gets their own website ID
  umamiEnabled   Boolean @default(false)

  // Status
  status             String  @default("active") // active | suspended | closed
  onboardingComplete Boolean @default(false)

  // SEO / AEO / GEO controls
  localBusinessEnabled        Boolean @default(false) // opt-in to emit LocalBusiness JSON-LD (only meaningful when address/phone is set)
  allowAiCrawlers             Boolean @default(true) // when false, blocks known AI-crawler bots in robots.txt
  sendAbandonedCheckoutEmails Boolean @default(false) // recovery email to shoppers who abandon a Stripe checkout (needs their email on the expired session)

  // Features
  featureFlags Json @default("{}") // Record<string, boolean>

  // Shipping (storefront + Stripe)
  shippingType          String  @default("free") // free | flat_rate | flat_rate_with_threshold | zone_weight
  shippingFlatRate      Int? // cents; used by flat_rate and flat_rate_with_threshold
  freeShippingThreshold Int? // cents; subtotal at which shipping becomes free (all modes)
  offersInStorePickup   Boolean @default(false)
  pickupLocation        String? // free-text pickup address; falls back to businessAddress when blank
  pickupInstructions    String? @db.Text // combined "pickup hours & instructions", shown verbatim at checkout + in emails

  // Zone + weight shipping fields
  originState                 String? // 2-letter US state code for shipping origin
  shippingWeightTiers         Json? // WeightTier[]: [{ label, minLb, maxLb }] (last tier maxLb: null = no cap)
  businessHours               Json? // BusinessHoursRow[] — see src/lib/business-hours.ts
  shippingFallbackRate        Int? // cents; used when destination state matches no zone
  shippingDefaultItemWeightLb Float?  @default(0) // assumed weight (lb) for products with no weight set

  // Country allowlist for sales/shipping. "US" is always implicitly allowed.
  salesCountries String[] @default([]) // additional countries beyond US: subset of ["CA","MX"]

  // Relationships
  products              Product[]
  collections           Collection[]
  services              Service[]
  orders                Order[]
  customers             Customer[]
  siteContent           SiteContent?
  images                Image[]
  discountCodes         DiscountCode[]
  inventoryHistory      InventoryHistory[]
  baseInventoryUnits    BaseInventoryUnit[]
  inventoryReservations InventoryReservation[]
  pages                 Page[]
  editorNotes           EditorNote[]
  productImports        ProductImport[]
  galleries             Gallery[]
  testimonials          Testimonial[]
  testimonialInvites    TestimonialInvite[]
  platformInvites       PlatformInvite[]
  teamInvites           TeamInvite[]
  memberships           BusinessMembership[]
  zones                 ShippingZone[]
  faqItems              FaqItem[]
  events                Event[]
  videos                Video[]
  videoSources          VideoSource[]
  backInStockRequests   BackInStockRequest[]
  quoteCalculators      QuoteCalculator[]
  quoteSubmissions      QuoteSubmission[]
  quickBooksConnection  QuickBooksConnection?
  quickBooksInvoices    QuickBooksInvoice[]
  subscriptions         Subscription[]

  // NOTE: no @@index on subdomain/customDomain — each is already @unique (own index).
}

model SiteContent {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt

  // Hero Section
  heroTitle      String?
  heroSubtitle   String?
  heroImageUrl   String?
  heroButtonText String?
  heroButtonLink String?

  // About Section
  aboutTitle    String?
  aboutText     String? @db.Text
  aboutImageUrl String?

  // Features (stored as JSON for flexibility)
  features Json? // [{ title, description, icon }]

  // Footer
  footerText  String?
  socialLinks Json? // { instagram, facebook, twitter }

  // SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  ogImage         String?
  faviconUrl      String?

  // Per-route meta overrides for storefront pages that have no DB row of their
  // own (/about, /contact, /shop, /blog, /collections, /services, /testimonials,
  // /faq, /events, /videos). Keyed by route:
  //   { "about": { title, description, ogImage }, ... }
  // Shape + parser: src/lib/validators/site-seo.ts. A map rather than a column
  // per route so shipping a new storefront route needs no migration.
  pageMeta Json?

  // Search-engine ownership tokens, e.g. { google, bing }. Emitted from the
  // root layout as Next's `verification` metadata. Written only by
  // business.updateSeo — deliberately kept OUT of siteContentSchema so the
  // branding editor, navigation builder and visual-editor publish transaction
  // cannot reach it (same protection as bannerConfig/popupConfig).
  siteVerification Json?

  // Logo
  logoUrl     String?
  logoAltText String?

  // Colors & Styling (template customization)
  primaryColor   String? @default("#000000")
  secondaryColor String? @default("#ffffff")
  accentColor    String? @default("#3b82f6")

  // Navigation (custom menu items)
  navigationItems Json? // [{ label, href }]

  //Misc Business Information
  customFields Json? // { key: value }

  bannerConfig Json? // BannerConfig — see src/lib/validators/site-banner.ts
  popupConfig  Json? // PopupConfig

  // Per-email-template copy overrides, keyed by email template id:
  // { "order-confirmation": { subject?: string, introText?: string }, ... }
  emailOverrides Json?

  // Owner-only preview draft (never shipped to public visitors)
  previewCustomFields Json?
  previewUpdatedAt    DateTime?

  // One-to-one with Business
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// FAQ — store-level FAQ items (one list per business)
// ---------------------------------------------------------------------------

model FaqItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question String
  answer   String @db.Text

  sortOrder Int     @default(0)
  published Boolean @default(true)

  // Multi-tenancy
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Product {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Basic Info
  name String
  slug String // URL-friendly, unique per business

  excerpt     String? @db.Text // Short description of the product
  description String? @db.Text // Long description of the product

  // Pricing
  price          Float // Base price in cents or dollars
  compareAtPrice Float? // Original price for "sale" display
  cost           Float? // Cost to business (for profit tracking)

  // Subscriptions ("subscribe & save" — Stripe Billing on the connected account)
  subscriptionEnabled         Boolean @default(false)
  subscriptionIntervals       Json? // string[] of interval keys, see src/lib/subscriptions/intervals.ts
  subscriptionDiscountPercent Int     @default(0)

  // Inventory
  sku                   String?
  barcode               String?
  trackInventory        Boolean @default(false)
  inventoryQty          Int     @default(0)
  reservedQty           Int     @default(0)
  allowBackorders       Boolean @default(false)
  lowInventoryThreshold Int?
  lowInventoryAlertSent Boolean @default(false)
  outOfStockAlertSent   Boolean @default(false)

  // Base inventory unit (pool) opt-in — when set, per-product trackInventory is disabled
  baseInventoryUnitId String?
  baseInventoryUnit   BaseInventoryUnit? @relation(fields: [baseInventoryUnitId], references: [id], onDelete: SetNull)
  baseUnitsConsumed   Int?

  // Physical attributes
  weight     Float? // in lbs or kg
  weightUnit String? @default("lb") // lb | kg

  // Organization
  published          Boolean   @default(false)
  featured           Boolean   @default(false)
  scheduledPublishAt DateTime? // when set and in the future, the cron publish job flips published=true at/after this time
  sortOrder          Int       @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  ogImage         String?

  // Multi-tenancy
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Relationships
  images              Image[]
  variants            ProductVariant[]
  collectionProducts  CollectionProduct[]
  orderItems          OrderItem[]
  inventoryHistory    InventoryHistory[]
  backInStockRequests BackInStockRequest[]
  subscriptions       Subscription[]

  // Computed fields (can be calculated on demand)
  averageRating Float?
  reviewCount   Int    @default(0)

  // Additional fields based on template needs
  additionalFields Json? // { key: value }

  reviews ProductReview[]

  @@unique([businessId, slug])
  @@index([businessId, published])
  @@index([businessId, featured])
  @@index([baseInventoryUnitId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Variant details
  name    String // e.g., "Small / Red"
  sku     String?
  barcode String?

  // Pricing (overrides product price if set)
  price          Float?
  compareAtPrice Float?

  // Inventory
  inventoryQty Int @default(0)
  reservedQty  Int @default(0)

  // Options (stored as JSON for flexibility)
  options Json // { size: "Small", color: "Red" }

  // Image
  imageUrl String?

  // Relationships
  productId        String
  product          Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryHistory InventoryHistory[]
  orderItems       OrderItem[]
  subscriptions    Subscription[]

  @@index([productId])
}

model Collection {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  slug        String
  description String? @db.Text
  imageUrl    String?

  published Boolean @default(true)
  sortOrder Int     @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  ogImage         String?

  // Multi-tenancy
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  collectionProducts CollectionProduct[]
  // NOTE: no @@index([businessId]) — covered by the @@unique([businessId, slug]) prefix.

  @@unique([businessId, slug])
}

model CollectionProduct {
  id        String @id @default(cuid())
  sortOrder Int    @default(0)

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  // NOTE: no @@index([collectionId]) — covered by the @@unique([collectionId, productId]) prefix.
  @@index([productId])
}

model Service {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  slug        String
  description String?
  image       String?

  // Which per-service page template renders this service's detail page
  serviceTemplateId String @default("service-one")

  // { key: value } — service-page template fields
  customFields Json?

  published Boolean @default(false)
  sortOrder Int     @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  ogImage         String?

  // Multi-tenancy
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  items ServiceItem[]

  @@unique([businessId, slug])
  @@index([businessId, published])
}

model ServiceItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  description String?
  image       String?

  // Display-only pricing / duration (not e-commerce)
  priceLabel    String?
  durationLabel String?

  // Display-only "was" price (free text, e.g. "$120"), shown struck-through.
  compareAtPriceLabel String?
  // [{ label, priceLabel, compareAtPriceLabel? }] — alternate priced rows (display-only).
  priceTiers          Json?
  // [{ name, priceLabel?, description? }] — optional extras (display-only).
  addOns              Json?

  // External booking iframe (sanitized HTTPS URL only)
  bookingEmbedSrc    String?
  bookingEmbedHeight Int?

  // Section assignment key (matches a section row `_id` defined in the parent
  // Service.customFields). Used only by category-aware templates (vii-collection);
  // null/ignored by all other service templates.
  category    String?
  isSignature Boolean @default(false)

  published Boolean @default(false)
  sortOrder Int     @default(0)

  // Parent service
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  // Denormalized for scoping queries without joining Service
  businessId String

  @@index([serviceId])
  @@index([businessId])
}

/// An upcoming event the owner wants shoppers to know about — a market, a class,
/// a make & take. Owners typically upload a flier as `coverImage`.
///
/// Deliberately NOT a commerce object: `priceLabel` is a display string, there is
/// no RSVP/ticketing, and there is no detail page (hence no `slug`). The flier is
/// opened full-size in a lightbox from the list.
model Event {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name       String
  blurb      String? @db.Text
  coverImage String? // flier/cover URL — plain string, same convention as Service.image

  // Always stored as UTC instants; displayed through Business.timeZone via
  // src/lib/events/format.ts. `allDay` events are normalized on write to
  // [00:00:00.000, 23:59:59.999] of the local date IN THE BUSINESS ZONE, so
  // `endAt ?? startAt` is always the correct "is it over yet" cutoff.
  startAt DateTime
  endAt   DateTime?
  allDay  Boolean   @default(false)

  location         String? // free-text venue or address line
  externalUrl      String? // optional outbound link (Eventbrite, FB event, signup form)
  externalUrlLabel String?
  priceLabel       String? // display-only ("$45 per person", "Free"). Never charges anyone,
  // and never emitted as schema.org `offers`.

  published  Boolean @default(true)
  sortOrder  Int     @default(0)
  // Flipped by the cron archive job once the event is over; the owner can undo it.
  // Public queries filter by date independently, so this is never load-bearing for
  // hiding a past event — it drives the admin Upcoming/Past split.
  isArchived Boolean @default(false)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Public storefront list.
  @@index([businessId, published, isArchived, startAt])
  // Admin list (both tabs) and the sitemap count.
  @@index([businessId, startAt])
  // The cron sweep, which is platform-wide and scans by cutoff, not by business.
  @@index([isArchived, endAt])
  @@index([isArchived, startAt])
}

/// A YouTube channel or playlist the owner registered as a feed to sync from.
///
/// Sync reads the public YouTube Atom feed for `externalId`; no API key, no OAuth,
/// so there is nothing here but an id and bookkeeping. `kind` is a plain string
/// ("channel" | "playlist") rather than an enum to keep this additive and to avoid
/// a migration if a third feed shape ever shows up.
///
/// `autoPublish` decides only what `Video.published` is set to at INSERT time for
/// videos discovered through this source. Flipping it later does not retroactively
/// publish or unpublish anything — see the ownership note on `Video`.
model VideoSource {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kind        String // "channel" | "playlist"
  externalId  String // UC… (channel) or PL…/UU… (playlist)
  label       String? // owner-facing name
  enabled     Boolean @default(true)
  autoPublish Boolean @default(true)

  // Bookkeeping written by the cron sync. `lastSyncError` holds the last failure
  // message (feed 404, network error, malformed XML) so the owner can see why a
  // source went quiet; it is cleared on the next successful run.
  lastSyncedAt  DateTime?
  lastSyncError String?   @db.Text

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  videos     Video[]

  // One row per feed per business. Registering the same channel twice is a no-op
  // upsert rather than a duplicate source producing duplicate work.
  @@unique([businessId, kind, externalId])
  // The cron sweep is platform-wide: it selects enabled sources ordered by the
  // stalest `lastSyncedAt` first (nulls = never synced) and takes a batch. This
  // index is what makes that selection cheap; it is not a per-business query.
  @@index([enabled, lastSyncedAt])
}

/// One YouTube video surfaced on the storefront.
///
/// ────────────────────────────────────────────────────────────────────────────
/// THE CORE INVARIANT: sync-owned columns vs owner-owned columns.
/// ────────────────────────────────────────────────────────────────────────────
/// This table has two writers with strictly separate column sets:
///
///   SYNC-OWNED  (cron, rewritten on EVERY run):
///     title, description, thumbnailUrl, channelTitle, publishedAt
///   OWNER-OWNED (admin UI only, written by the cron ONLY at first insert):
///     titleOverride, descriptionOverride, thumbnailOverride, published, sortOrder
///
/// The sync upsert MUST list only the sync-owned columns in its `update` clause.
/// Renders resolve through the overrides — `titleOverride ?? title`,
/// `descriptionOverride ?? description`, `thumbnailOverride ?? thumbnailUrl` — so
/// the owner's edits survive YouTube renaming a video, and YouTube's metadata
/// still refreshes underneath them.
///
/// ⚠️ If a future reader "simplifies" that upsert into writing the whole object
/// (e.g. spreading the same payload into both `create` and `update`), every owner
/// edit, every unpublish, and every manual ordering choice is silently overwritten
/// on the next cron tick. There is no error, no constraint violation, and no test
/// that fails by construction — the data is just quietly gone. Keep the split.
///
/// ────────────────────────────────────────────────────────────────────────────
/// ROWS ARE NEVER DELETED BECAUSE A VIDEO LEFT THE FEED.
/// ────────────────────────────────────────────────────────────────────────────
/// The YouTube Atom feed carries only the ~15 most recent entries. Older videos
/// falling out of the feed is normal, expected behavior — not a signal that they
/// were removed from YouTube. Reconciling by deleting local rows absent from the
/// feed would wipe the owner's entire back catalogue on the very first sync of an
/// established channel. Sync is insert/update only; rows leave this table solely
/// by explicit owner action in the admin UI.
model Video {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The 11-character YouTube video id (the `v=` parameter). Everything public —
  // watch URL, embed URL, thumbnail fallbacks — is derived from this.
  youtubeId String

  // ── Sync-owned. Overwritten on every sync run. Never hand-edit these. ────────
  title        String
  description  String?  @db.Text
  thumbnailUrl String?
  channelTitle String?
  publishedAt  DateTime

  // ── Owner-owned. Written at first insert, then only by the admin UI. ─────────
  // Nullable overrides mean "not customized" — resolution is `override ?? synced`,
  // so clearing an override falls back to live YouTube metadata rather than to an
  // empty string.
  titleOverride       String?
  descriptionOverride String? @db.Text
  thumbnailOverride   String?
  // Seeded from the source's `autoPublish` at insert; owner-controlled thereafter.
  published           Boolean @default(true)
  // Manual ordering; storefront lists fall back to `publishedAt` desc within a tie.
  sortOrder           Int     @default(0)

  // Null = the owner added this video by hand (pasted a URL), not via a feed.
  //
  // SetNull, deliberately NOT Cascade: removing a channel/playlist means "stop
  // pulling new videos from this feed", not "destroy the videos I already curated,
  // reordered, and wrote custom copy for". Deleting a source demotes its videos to
  // manual entries, which the owner can then keep or delete individually.
  sourceId String?
  source   VideoSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // The upsert target for sync, and the deduper. Note the scope: (business, video),
  // NOT (source, video). An owner may register their own channel AND someone else's
  // playlist that features the same video, so the identical `youtubeId` legitimately
  // arrives from two different feeds in one run. Keying on the business collapses
  // those into a single row (first source to insert it wins `sourceId`) instead of
  // showing the shopper the same video twice.
  @@unique([businessId, youtubeId])
  // Public storefront list: published videos, newest first.
  @@index([businessId, published, publishedAt])
  // Admin list and any owner-ordered render.
  @@index([businessId, sortOrder])
}

model Image {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  url       String
  altText   String?
  width     Int?
  height    Int?
  sortOrder Int     @default(0)

  // What this image is for
  productId  String?
  businessId String?

  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([businessId])
}

model Customer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // email/firstName/lastName stay PLAINTEXT: DB-side @@unique([businessId, email])
  // lookups/upserts, admin contains-search, and customer.list's name orderBy all
  // require it. Encrypted PII expansion is deliberate (scripts/encrypt-existing-pii.ts).
  email     String
  firstName String?
  lastName  String?
  phone     String? /// @encrypted

  // Stripe
  stripeCustomerId String? // per-business Stripe Customer on the connected account

  // Marketing
  acceptsMarketing Boolean @default(false)

  // Stats
  totalSpent Int @default(0)
  orderCount Int @default(0)

  // GDPR/CCPA data-subject rights
  deletionRequestedAt DateTime?
  anonymizedAt        DateTime?

  // Owner-facing CRM notes (never shown to the customer)
  notes String? @db.Text /// @encrypted

  // Link to authenticated user (if they've signed in)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Multi-tenancy (customer exists per business)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  orders             Order[]
  shippingAddresses  ShippingAddress[]
  testimonials       Testimonial[]
  testimonialInvites TestimonialInvite[]
  reviews            ProductReview[]
  subscriptions      Subscription[]

  @@unique([businessId, email])
  // NOTE: no @@index([businessId]) — covered by the @@unique([businessId, email]) prefix.
  @@index([userId])
}

model ShippingAddress {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName String /// @encrypted
  lastName  String /// @encrypted
  company   String? /// @encrypted
  address1  String /// @encrypted
  address2  String? /// @encrypted
  city      String /// @encrypted
  province  String? /// @encrypted State/Province
  country   String
  zip       String /// @encrypted
  phone     String? /// @encrypted

  isDefault Boolean @default(false)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orders        Order[]
  subscriptions Subscription[]

  @@index([customerId])
}

model Order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Acceptance of the MERCHANT's terms, captured at checkout. This lives on the
  // Order rather than in a consent table on purpose: the buyer↔merchant
  // relationship is formed per-transaction, and an order is already an
  // immutable record of one. It also covers guest buyers, who never create an
  // account and so are never reached by `User.termsAcceptedAt`.
  //
  // `merchantTermsUpdatedAt` snapshots the `updatedAt` of the merchant's
  // terms-of-service Page at time of purchase — merchants can edit their
  // policies freely, so without this there is no way to tell which wording was
  // actually shown. Null when the merchant published no terms page at all.
  termsAcceptedAt        DateTime?
  termsVersion           String?
  merchantTermsUpdatedAt DateTime?

  // Order number (human-readable, e.g., #1001)
  orderNumber Int

  // Status
  status            String @default("open") // open | completed | cancelled | refunded 
  paymentStatus     String @default("pending") // pending | paid | failed | refunded
  fulfillmentStatus String @default("unfulfilled") // unfulfilled | fulfilled | partially_fulfilled

  // Stripe
  stripeSessionId       String? @unique
  stripePaymentIntentId String?
  stripeInvoiceId       String? @unique // set for subscription-billed orders only; stripeSessionId stays null for these

  // Subscription (set only when this order was created from a paid subscription invoice)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  // Pricing (in cents)
  subtotal Int
  tax      Int @default(0)
  shipping Int @default(0)
  discount Int @default(0)
  total    Int

  // Customer info (denormalized for historical record)
  // customerEmail/customerName/customerFirstName/customerLastName stay PLAINTEXT —
  // admin orders search, CSV-export filter, and global admin search run contains-filters on them.
  customerEmail     String
  customerName      String? // For simpler storage (combines first+last)
  customerFirstName String?
  customerLastName  String?
  customerPhone     String? /// @encrypted

  // Payment
  paymentMethod String @default("card") // card | cash | check | manual

  // Fulfillment method chosen at checkout
  deliveryMethod String @default("ship") // ship | pickup

  // Refund
  refundReason      String?
  refundAmountCents Int? // cumulative refunded amount in cents (partial or full)

  // Notes
  customerNote String? @db.Text /// @encrypted
  internalNote String? @db.Text /// @encrypted

  // Multi-tenancy
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  shippingAddressId String?
  shippingAddress   ShippingAddress? @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)

  discountCodeId String?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)

  items            OrderItem[]
  inventoryHistory InventoryHistory[]
  reviews          ProductReview[]
  shipments        OrderShipment[]

  @@unique([businessId, orderNumber])
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([customerId])
  @@index([shippingAddressId])
  @@index([discountCodeId])
  @@index([stripePaymentIntentId])
  @@index([subscriptionId])
}

model OrderShipment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  shippedAt DateTime @default(now())

  carrier        String?
  trackingNumber String?
  trackingUrl    String?

  // Line-item contents of this shipment for partial fulfillment:
  // [{ orderItemId: string, quantity: number }]. Null = legacy whole-order shipment.
  items Json?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderItem {
  id String @id @default(cuid())

  // Product info (snapshot at time of order)
  productName String
  variantName String?
  sku         String?

  // Pricing (snapshot)
  price    Float
  quantity Int
  total    Float // price * quantity

  // Units already shipped across this order's shipments (partial fulfillment)
  fulfilledQuantity Int @default(0)

  // Relationships (nullable in case product is deleted)
  productId        String?
  productVariantId String?

  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
}

// For tracking which domains need to be added to Coolify
model DomainQueue {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  domain     String @unique
  businessId String
  status     String @default("pending") // pending | processing | completed | failed

  attempts  Int     @default(0)
  lastError String?

  @@index([status])
}

// ============================================
// DISCOUNTS & PROMOTIONS
// ============================================

model DiscountCode {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Code details
  code  String // "SUMMER20", "SAVE10"
  type  String // "percentage" | "fixed"
  value Int // 20 (for 20%) or 1000 (for $10 in cents)

  // Status
  active Boolean @default(true)

  // Usage limits
  usageLimit       Int? // null = unlimited (total redemptions)
  usageCount       Int  @default(0)
  perCustomerLimit Int? // null = unlimited; enforced by counting the customer's prior orders using this code

  // Validity period
  startsAt  DateTime?
  expiresAt DateTime?

  // Restrictions
  minPurchase Int? // minimum order value in cents
  maxDiscount Int? // cap discount amount in cents

  // Relationships
  orders Order[]

  @@unique([businessId, code])
  // NOTE: no @@index([businessId]) — covered by the @@unique([businessId, code]) / @@index([businessId, active]) prefix.
  @@index([businessId, active])
  @@index([code])
}

// ============================================
// INVENTORY MANAGEMENT
// ============================================

model InventoryHistory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // What changed
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  baseInventoryUnitId String?
  baseInventoryUnit   BaseInventoryUnit? @relation(fields: [baseInventoryUnitId], references: [id], onDelete: Cascade)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Quantity changes
  previousQty Int
  newQty      Int
  changeQty   Int // positive = increase, negative = decrease

  // Why it changed
  reason String // "sale", "return", "restock", "adjustment", "correction", "damage"
  note   String? @db.Text

  // References
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([productId])
  @@index([baseInventoryUnitId])
  @@index([businessId])
  @@index([orderId])
  @@index([userId])
  @@index([createdAt])
}

