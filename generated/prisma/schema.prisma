model Page {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  // Page identity
  title   String
  slug    String // about, contact, privacy, terms, etc.
  content Json
  excerpt String? @db.Text

  image String?

  // SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  ogImage         String?

  // Status
  published          Boolean   @default(true)
  sortOrder          Int       @default(0)
  scheduledPublishAt DateTime? // when set and in the future, the cron publish job flips published=true at/after this time

  // Visual-editor draft: { title, excerpt, content } — null = no draft.
  // Applied to the live columns + cleared by the editor's Publish; must never be
  // returned by public procedures.
  previewDraft          Json?
  previewDraftUpdatedAt DateTime?

  // Page type
  type     String @default("page") // page | policy | blog | custom
  template String @default("default") // default | sidebar | full-width

  // Relationships
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, slug])
  @@index([businessId, published])
  @@index([businessId, type])
