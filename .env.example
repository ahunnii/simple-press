# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# ============================================================================
# CORE APPLICATION
# ============================================================================

NODE_ENV="development"

# ============================================================================
# AUTHENTICATION & AUTHORIZATION
# ============================================================================

# Better Auth Secret
# You can generate a new secret on the command line with: npx auth secret
# https://next-auth.js.org/configuration/options#secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_BASE_URL="http://localhost:3000"

# Better Auth Discord Provider
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Invitation code for new business registration (required to bypass platform invite)
INVITATION_CODE=""

# ============================================================================
# DATABASE
# ============================================================================

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/multi-vendor-web"

# PII field-level encryption (prisma-field-encryption)
# Generate with: node -e "const c=require('crypto');console.log('k1.aesgcm256.'+c.randomBytes(32).toString('base64'))"
PRISMA_FIELD_ENCRYPTION_KEY=""

# ============================================================================
# STORAGE (MinIO)
# ============================================================================

MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
NEXT_PUBLIC_STORAGE_URL="http://localhost:9000"
NEXT_PUBLIC_STORAGE_BUCKET_NAME="simple-press"

# ============================================================================
# EMAIL & NOTIFICATIONS
# ============================================================================

# Resend email service
RESEND_API_KEY=""

# Email from addresses
NEXT_PUBLIC_EMAIL_FROM_NOREPLY="noreply@example.com"
NEXT_PUBLIC_EMAIL_FROM_ORDERS="orders@example.com"
NEXT_PUBLIC_EMAIL_FROM_SUPPORT="support@example.com"

# Discord webhook for platform alerts
DISCORD_WEBHOOK_URL=""

# ============================================================================
# STRIPE
# ============================================================================

STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_CONNECT_CLIENT_ID=""
STRIPE_WEBHOOK_SECRET=""

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================

# Umami Analytics
UMAMI_BASE_URL="http://localhost:3001"
UMAMI_API_USERNAME=""
UMAMI_API_PASSWORD=""
# Or alternatively, use base64-encoded password (preferred for hosting platforms that mangle special chars):
# UMAMI_API_PASSWORD_B64=""

NEXT_PUBLIC_ENABLE_UMAMI="false"
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# ============================================================================
# PLATFORM CONFIGURATION
# ============================================================================

# Platform domain (used for storefront URLs)
NEXT_PUBLIC_PLATFORM_DOMAIN="example.com"
NEXT_PUBLIC_PLATFORM_CONTACT_EMAIL="support@example.com"

# VPS IP for infrastructure operations
VPS_IP="1.2.3.4"

# Help documentation URL
NEXT_PUBLIC_HELP_URL="https://help.example.com"

# ============================================================================
# SECURITY
# ============================================================================

# hCaptcha (optional but recommended for production)
HCAPTCHA_SECRET_KEY=""
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=""

# Internal hash secret (used for Stripe OAuth state, cron endpoint bearer, etc.)
SIMPLEPRESS_HASH_SECRET=""

# Cron endpoint secret (optional; when unset, cron endpoint refuses all requests)
CRON_SECRET=""

# ============================================================================
# ARTISANAL FUTURES INTEGRATION
# ============================================================================

# Artisanal Futures API endpoint
ARTISANAL_FUTURES_API_URL="https://api.artisanal-futures.example/api"

# Bearer token for outbound calls to Artisanal Futures API
ARTISANAL_FUTURES_API_TOKEN=""

# Bearer token for inbound calls from Artisanal Futures partner API
AF_PARTNER_API_TOKEN=""

# Shared HMAC secret for both inbound and outbound partner requests
AF_SP_WEBHOOK_SECRET=""

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Redis (optional; used for rate limiting and caching)
REDIS_URL="redis://localhost:6379"

# Preview/staging environment flag (when "true", disables outbound email and adds noindex header)
IS_PREVIEW_ENV="false"

# Email redirect for preview environments (optional; when set, all outbound email is rerouted to this address)
EMAIL_REDIRECT_TO=""
